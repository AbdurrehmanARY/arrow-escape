# .easignore - controls what EAS Build excludes from upload
# This file REPLACES .gitignore for EAS purposes. Must include all standard exclusions.
# Standard exclusions (mirror .gitignore + default EAS exclusions)
node_modules/
.git/
*.apk
*.aab
dist/
web-build/
.expo/
.expo-export-check/
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.env*.local/
*.tsbuildinfo
.audit-state.json
*.log
.idea/
.vscode/
.claude/
__pycache__/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
coverage/
.expo-export-check/
fix.ps1
fix_indent.py
/build/
/tools/_scratch-*.ts

# Native directories — regenerated by expo prebuild; must NOT be uploaded

# (this is the root cause of bare-vs-managed detection errors)
/android/
/ios/

# Junk files not referenced by the app
assets/heart.jpg
assets/heartfilled.jpg
scripts/
supabase/.temp/

# Allow credentials (these ARE in .gitignore but needed for credentialsSource: local)
!credentials.json
!keystore/
!keystore/**
