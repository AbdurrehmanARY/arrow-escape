# Local, machine-only build switches. GITIGNORED (.env*.local) so this file is
# never committed and never uploaded to EAS — a production cloud build therefore
# cannot inherit it and can never ship test ads.
#
# Why it exists: the standalone test APK sets `debuggableVariants = []` so the
# `debug` variant embeds its JS bundle (no Metro server needed). React Native's
# Gradle plugin then bundles that variant with `--dev false`, so `__DEV__` is
# `false` inside the APK and `USE_TEST_ADS = __DEV__` would serve REAL ads. This
# override pins test ad units for local tester builds only.
EXPO_PUBLIC_USE_TEST_ADS=true
e