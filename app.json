          "resizeMode": "contain",
          "backgroundColor": "#EEEBE4",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1120"
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font"
    ],
    "scheme": "arrowpuzzle",
