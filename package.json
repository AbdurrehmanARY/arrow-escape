{
  "name": "arrow-escape-game",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.10",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --tunnel --clear",
    "dev": "expo start --dev-client",
    "dev:clear": "expo start --dev-client --clear",
    "dev:tunnel": "expo start --dev-client --tunnel --clear",
    "eas": "npx --yes eas-cli@latest",
    "build:dev": "npx --yes eas-cli@latest build --profile development --platform android",
    "build:preview": "npx --yes eas-cli@latest build --profile preview --platform android",
    "build:prod": "npx --yes eas-cli@latest build --profile production --platform android",
    "build:dev:local": "npx --yes eas-cli@latest build --profile development --platform android --local",
    "eas:login": "npx --yes eas-cli@latest login",
    "eas:configure": "npx --yes eas-cli@latest build:configure",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run levels:validate",
    "levels:build": "tsx tools/build-levels.ts",
    "levels:preview": "tsx tools/preview-themes.ts",
    "levels:validate": "tsx tools/validate.ts",
    "levels:check": "tsx tools/check-curriculum.ts",
    "levels:probe": "tsx tools/probe-tiers.ts",
    "bench": "tsx tools/bench.ts",
    "start:clear": "expo start --clear",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shapes:inspect": "tsx tools/inspect-shapes.ts",
    "icons:build": "tsx tools/make-icons.ts",
    "sounds:build": "tsx tools/make-sounds.ts"
  },
  "private": true
}
