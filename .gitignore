# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test + build artifacts
coverage/
.expo-export-check/

# generated native folders
/ios
/android

# build output captured for inspection; the level packs themselves are committed
# Build and verification transcripts, written by npm scripts when run to a file.
# This single rule covers every transcript (`build.log`, `gradle-build.log`,
# `metro-dev.log`, ...) rather than the three names we happened to hit first.
/*.log

# JetBrains IDE settings — local to one machine.
.idea/

# VS Code workspace settings — same reasoning as `.idea/` above.
.vscode/

# Python bytecode left behind by the offline QA scripts in the repo root.
__pycache__/

# Claude Code local settings and scratch files.
.claude/settings.local.json
.claude/*.tmp.*

# Locally built APKs, scratch scripts, and other build artifacts — large, and rebuilt from source on demand.
/build/
*.apk
*.aab
/tools/_scratch-*.ts
fix.ps1
fix_indent.py

# Orphan / duplicate image patterns from the Phase A audit.
# These are byte-identical duplicates or unreferenced orphans that should
# never be re-committed. Tracked under their canonical names only.
#   - awards/*_YYYYMMDDHHMM.webp: timestamped duplicate variants kept by
#     the source tool's naming convention (e.g. unstoppable.jpg_*.webp).
#   - Loose branding images at assets/ root, not referenced by the registry.
assets/awards/*_*[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].*
assets/Charcoal_3D_arrow_icon_*.webp
assets/Black_silhouette_logo_mark_*.webp

