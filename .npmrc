# The Expo 57 dependency tree ships a `react-dom@19.2.8` (via @expo/devtools) that
# demands react ^19.2.8, while the project is pinned to the react 19.2.3 that
# react-native 0.86 expects. npm's strict peer resolution treats that as a hard
# conflict and refuses to install anything.
#
# This is set here rather than passed per-command on purpose: mixing strict and
# legacy installs against the same tree prunes packages that the other mode had
# placed, which silently breaks the babel and jest toolchains.
legacy-peer-deps=true
