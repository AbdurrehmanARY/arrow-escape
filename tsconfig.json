{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "jest",
      "node",
      "react"
    ],
    "paths": {
      "@game": [
        "./src/game/index.ts"
      ],
      "@render": [
        "./src/render/index.ts"
      ],
      "@render/*": [
        "./src/render/*"
      ],
      "@challenge": [
        "./src/challenge/index.ts"
      ],
      "@league": [
        "./src/league/index.ts"
      ],
      "@league/*": [
        "./src/league/*"
      ],
      "@challenge/*": [
        "./src/challenge/*"
      ],
      "@game/*": [
        "./src/game/*"
      ],
      "@theme": [
        "./src/theme/index.ts"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@components": [
        "./src/components/index.ts"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@state/*": [
        "./src/state/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@data": [
        "./src/data/index.ts"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@state": [
        "./src/state/index.ts"
      ],
      "@services": [
        "./src/services/index.ts"
      ],
      "@config": [
        "./src/config/index.ts"
      ],
      "@brand": [
        "./src/brand/index.ts"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@features/*": [
        "./src/features/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
